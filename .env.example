# Copy to .env and fill in. NEVER commit real values — .env is gitignored.
# The agent reads these via its tools; card numbers and full secrets stay OUT of the repo,
# out of prompts, and out of anything the agent pastes into a web page.

TELEGRAM_BOT_TOKEN=        # daily-report + request-approval skills post via this bot
TELEGRAM_CHAT_ID=          # the bot's report group chat id
TELEGRAM_OWNER_CHAT_ID=    # owner's NUMERIC DM chat id. THE auth anchor: the only sender poll-approvals.sh accepts an approval from (the group + all other DMs are ignored). Get it from https://api.telegram.org/bot<token>/getUpdates after you DM the bot. If unset, DM approvals are refused (fail closed) and the ping falls back to TELEGRAM_CHAT_ID
STRIPE_RESTRICTED_KEY=     # RESTRICTED key only (Payment Links/Products scope) — never the live secret key
# Privacy.com access is via its MCP server (OAuth) — no key stored here
# ANTHROPIC_API_KEY / model keys: only if the daily loop runs headless via API

# --- Liveness / watchdog (scripts/run-daily.sh + scripts/check-liveness.sh) ---
HEALTHCHECK_URL=           # external dead-man's-switch ping URL (e.g. healthchecks.io); catches "machine was off, nothing ran". Wrapper pings it on a COMPLETE run, and <URL>/fail on an incomplete one
OPERATING_WINDOW=          # "HH:MM-HH:MM" local (e.g. 07:00-22:00) — watchdog only alerts inside it; matches the charter's 3DS window
STALE_AFTER_HOURS=26       # watchdog alerts if no COMPLETE run within this many hours
AUTO_RECOVER=0             # 1 = watchdog auto-triggers ONE catch-up run when stale (guarded by the run lock); also enables the sandbox-engine self-heal (orb start)
RUN_TIMEOUT_SECS=1500      # per-attempt hard cap (a hang can't run forever)

# --- Optional sandbox module (see README "Sandboxed dev work"); leave 0 unless your avenue builds untrusted code ---
SANDBOX_ENABLED=0          # 1 = you built the sandbox image + want the watchdog to probe the Docker/OrbStack engine. Requires Docker/OrbStack + scripts/sandbox-build.sh
RUN_MAX_RETRIES=1          # auto-resume attempts after the first run if the trail is incomplete
PUSH_ON_RUN=1              # 1 = auto-push the per-run commit to the bot's OWN repo (0 to keep local)
