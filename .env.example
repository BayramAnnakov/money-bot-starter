# Copy to .env and fill in. NEVER commit real values — .env is gitignored.
# The agent reads these via its tools; card numbers and full secrets stay OUT of the repo,
# out of prompts, and out of anything the agent pastes into a web page.

TELEGRAM_BOT_TOKEN=        # daily-report skill posts via this bot
TELEGRAM_CHAT_ID=          # e.g. the group chat id
STRIPE_RESTRICTED_KEY=     # RESTRICTED key only (Payment Links/Products scope) — never the live secret key
# Privacy.com access is via its MCP server (OAuth) — no key stored here
# ANTHROPIC_API_KEY / model keys: only if the daily loop runs headless via API
